# NÃO coloque segredos aqui. Credenciais ficam no Gerenciador de Credenciais do Windows
# (rex credenciais). Este arquivo só documenta as chaves usadas pela aplicação.
#
# Variáveis de ambiente opcionais (sobrescrevem config/settings.yaml):
REX_OLLAMA_HOST=http://127.0.0.1:11434
REX_DB_PATH=data/rendaextra.db
REX_SAIDAS=saidas
#
# Chaves guardadas no cofre (serviço "rendaextra"):
#   kiwify_client_id, kiwify_client_secret, kiwify_account_id
#   hotmart_client_id, hotmart_client_secret, hotmart_basic
#   anthropic_api_key   (opcional)
#   openai_api_key      (opcional)
#
# Só para servidores sem cofre (ex.: Ubuntu sem keyring): defina como variável de ambiente
# na sessão, nunca em arquivo versionado. Ex.: REX_KIWIFY_CLIENT_SECRET=...
