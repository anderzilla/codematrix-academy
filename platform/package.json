{
  "name": "codematrix-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeMatrix Academy — Plataforma fechada multi-curso (Etapa 1: fundação e vitrine pública)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern data",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed-catalog.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  }
}
