# CodeMatrix Academy — Variáveis de ambiente (NUNCA commitar .env com valores reais)

# URL canônica da aplicação Academy (separada de https://www.codematrix.com.br)
ACADEMY_PUBLIC_URL=http://127.0.0.1:3100
ACADEMY_CORPORATE_SITE_URL=https://www.codematrix.com.br
ACADEMY_SUPPORT_EMAIL=contato@codematrix.com.br

# Persistência local SQLite (em produção usar banco dedicado e backup externo)
ACADEMY_DB_PATH=./data/academy.sqlite

# Caminho opcional para a fonte local do curso Formação IA/AnderZilla (usado pelo script de seed)
ACADEMY_COURSE_SOURCE_DIR=G:\Estudos de IA

# Sessão e cookies isolados da Academy (ativados na Etapa 2)
ACADEMY_SESSION_COOKIE_NAME=cm_academy_session
ACADEMY_SESSION_SECRET=

# Hotmart — Adapter de checkout e webhook
# Em produção, HOTMART_MODE=production exige HOTMART_HOTTOK preenchido (fail-closed)
HOTMART_MODE=sandbox
HOTMART_HOTTOK=
HOTMART_CHECKOUT_BASE_URL=https://pay.hotmart.com
# Mapa JSON opcional SKU -> { productId, offerCode, checkoutUrl }
HOTMART_PRODUCT_MAP_JSON={}

# Cloudflare Stream (ativado na Etapa 2; manter apenas no servidor/Secret Manager)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=academy.codematrix.com.br
